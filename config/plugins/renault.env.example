# ===========================================================================
#  Sentinella plugin: Renault Zoe (MY Renault / Gigya + Kamereon)
# ===========================================================================
#  Copy this file to renault.env (chmod 600) or configure credentials in the
#  Sentinella WebUI Settings Drawer under "RENAULT ZOE".
#  If any of the values below are empty, the plugin exits 0 as a no-op.
# ===========================================================================

RENAULT_USER=""
RENAULT_PASS=""
RENAULT_VIN=""

# Notification thresholds (CallMeBot / Signal gateway)
RENAULT_NOTIFY_LOW_ENABLED="0"
RENAULT_NOTIFY_LOW_SOC="20"
RENAULT_NOTIFY_HIGH_ENABLED="0"
RENAULT_NOTIFY_HIGH_SOC="80"
