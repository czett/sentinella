# ===========================================================================
#  Sentinella plugin: Open-Meteo Weather
# ===========================================================================
#  Copy this file to weather.env and set the values you want to override.
#  Leave a value empty (or omit the file entirely) and the plugin resolves it
#  once through https://ipapi.co/json/ and caches the result back into
#  weather.env. Once a value is set here it is treated as a user override and
#  is never replaced by IP geolocation.
#
#  API: https://open-meteo.com/ (Free, zero API keys required)
# ===========================================================================

# Location (decimal degrees and city label); empty = auto-detect via IP
WEATHER_CITY=""
WEATHER_LAT=
WEATHER_LON=

# Optional transport tuning
# WEATHER_CONNECT_TIMEOUT=5
# WEATHER_MAX_TIME=15
