# ===========================================================================
#  Sentinella plugin: Open-Meteo Weather
# ===========================================================================
#  Copy this file to weather.env and adjust coordinates if needed.
#  The plugin works without this file and automatically falls back to
#  forecast_solar.env (if present) or default coordinates (51.51, 7.46).
#
#  API: https://open-meteo.com/ (Free, zero API keys required)
# ===========================================================================

# Location (decimal degrees)
WEATHER_LAT=51.51
WEATHER_LON=7.46

# Optional transport tuning
# WEATHER_CONNECT_TIMEOUT=5
# WEATHER_MAX_TIME=15
