# ===========================================================================
#  Sentinella plugin: forecast.solar
# ===========================================================================
#  Copy this file to forecast_solar.env and adjust it for your roof.
#  The plugin works without this file and falls back to the defaults below.
#
#  API: https://api.forecast.solar/estimate/:lat/:lon/:declination/:azimuth/:kwp
#  Free, no API key. The service rate-limits per IP (12 requests/hour).
# ===========================================================================

# Location (decimal degrees)
FORECAST_LAT=51.43
FORECAST_LON=7.76

# PV geometry
#   FORECAST_DEC : tilt / declination in degrees (0 = flat, 90 = vertical)
#   FORECAST_AZ  : azimuth, 0 = south, -90 = east, 90 = west
#   FORECAST_KWP : installed peak power in kWp (not kW)
FORECAST_DEC=35
FORECAST_AZ=0
FORECAST_KWP=10

# Optional transport tuning
# FORECAST_CONNECT_TIMEOUT=5
# FORECAST_MAX_TIME=20
