# ===========================================================================
#  Sentinella plugin: forecast.solar (EXPERIMENTAL)
# ===========================================================================
#  Copy this file to forecast_solar.env and adjust it for your roof, or
#  configure the parameters directly in the Sentinella WebUI Settings Drawer.
#  Explicit configuration of FORECAST_LAT, FORECAST_LON, and FORECAST_KWP
#  is required before the plugin queries the API.
#
#  API: https://api.forecast.solar/estimate/:lat/:lon/:declination/:azimuth/:kwp
#  Free, no API key. The service rate-limits per IP (12 requests/hour).
# ===========================================================================

# Location (decimal degrees, required)
FORECAST_LAT=
FORECAST_LON=

# PV geometry
#   FORECAST_DEC : tilt / declination in degrees (0 = flat, 90 = vertical)
#   FORECAST_AZ  : azimuth, 0 = south, -90 = east, 90 = west
#   FORECAST_KWP : installed peak power in kWp (required, > 0)
FORECAST_DEC=35
FORECAST_AZ=0
FORECAST_KWP=

# Optional transport tuning
# FORECAST_CONNECT_TIMEOUT=5
# FORECAST_MAX_TIME=20
