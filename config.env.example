# /usr/local/addons/sma_soc/config.env
# Copy to config.env, fill in the password, then:
#   chown root:root config.env && chmod 600 config.env
#
# Values are sourced by /bin/sh. Quote values with single quotes if they
# contain spaces or shell metacharacters.

# --- SMA STP inverter -------------------------------------------------------
SMA_HOST="192.168.178.123"
SMA_RIGHT="usr"                 # "usr" (installer) or "user"
SMA_PASS='CHANGE_ME'            # use single quotes if it contains $ ` " etc.

# Battery state of charge (OBIS channel), 0..100 %
SMA_SOC_KEY="6100_00295A00"

# SMA devices normally use a self-signed certificate -> -k.
# Set to 0 only if the CCU3 trusts the inverter certificate.
SMA_INSECURE="1"

SMA_CONNECT_TIMEOUT="5"         # seconds
SMA_MAX_TIME="15"               # seconds per request
SMA_RETRIES="2"                 # whole login/read/logout cycles
SMA_RETRY_DELAY="5"             # seconds between attempts

# --- CCU3 -------------------------------------------------------------------
CCU_REGA_URL="http://127.0.0.1:8181/tclrega.exe"

SV_SOC_NAME="SV_Batterie_SoC"
SV_SIGNAL_NAME="SV_Batterie_95_Signal"

# Hysteresis: true at >= ON, false at <= OFF, state held in between.
SV_SIGNAL_ON="95"
SV_SIGNAL_OFF="90"
