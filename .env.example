# =============================================================================
#  homematic-sma-battery-monitor - configuration
# =============================================================================
#  Copy this file to `.env`, fill in the values, then protect it:
#
#      cp .env.example .env
#      chmod 600 .env
#
#  The file is sourced by POSIX /bin/sh. Quote every value. Single quotes are
#  safest for secrets (they stop $, `, \ and ! from being interpreted).
#  Type hints below are documentation only; bin/check_soc.sh validates them at
#  startup and refuses to run with an invalid configuration.
# =============================================================================


# -----------------------------------------------------------------------------
#  SMA inverter (WebConnect / local WebUI JSON API)
# -----------------------------------------------------------------------------

# [string] IPv4 address or DNS name of the inverter. No scheme, no trailing /.
SMA_IP="192.168.178.123"

# [int] HTTPS port of the inverter WebUI (default 443).
SMA_PORT="443"

# [enum: usr|user] WebUI login role. "usr" is the installer account.
SMA_ROLE="usr"

# [secret, required] WebUI password of the account above.
SMA_PASS='CHANGE_ME'

# [string] Battery state-of-charge channel. 6100_00295A00 is the standard
# battery SoC key on Sunny Tripower / Sunny Boy Storage devices. The key can
# differ by firmware and device class; see docs/PROTOCOL.md for discovery.
BATTERY_SOC_KEY="6100_00295A00"

# [string] Optional battery power channels used by the dashboard to show a
# real charging/discharging state. Leave empty to derive the state from the
# SoC trend instead. Known STP keys are shown below; set them to "" if your
# firmware does not expose them (the monitor then simply falls back).
BATTERY_CHARGE_POWER_KEY="6100_00417800"
BATTERY_DISCHARGE_POWER_KEY="6100_00417900"

# [bool: true|false] Verify the inverter TLS certificate. SMA devices usually
# use a self-signed certificate, so `false` (curl -k) is the safe default.
SMA_TLS_VERIFY="false"

# [int, seconds] Connection timeout and total request timeout.
SMA_CONNECT_TIMEOUT="5"
SMA_MAX_TIME="15"

# [int] Whole login/read/logout cycles before giving up. Minimum 1.
SMA_RETRIES="2"

# [int, seconds] Pause between attempts.
SMA_RETRY_DELAY="5"


# -----------------------------------------------------------------------------
#  Homematic CCU3 / RaspberryMatic (ReGaHSS)
# -----------------------------------------------------------------------------

# [string] Address of the CCU. On the CCU itself this is 127.0.0.1.
CCU_IP="127.0.0.1"

# [int] ReGaHSS HTTP port (CCU3 default: 8181).
CCU_REGA_PORT="8181"

# [string, alphanumeric + underscore] System variable that receives the SoC.
SV_SOC_NAME="SV_Batterie_SoC"

# [string, alphanumeric + underscore] Boolean system variable for the 95 % signal.
SV_SIGNAL_NAME="SV_Batterie_95_Signal"


# -----------------------------------------------------------------------------
#  Hysteresis
# -----------------------------------------------------------------------------

# [int 0..100] Set the signal variable to true at or above this SoC.
THRESHOLD_TRIGGER="95"

# [int 0..100] Set it back to false at or below this SoC. Must be lower than
# THRESHOLD_TRIGGER. Between the two thresholds the previous state is held.
THRESHOLD_RESET="90"


# -----------------------------------------------------------------------------
#  Signal messenger notifications (CallMeBot) - optional
# -----------------------------------------------------------------------------

# [bool: true|false] Master switch for phone notifications. The CCU system
# variables are updated regardless of this setting.
SIGNAL_ENABLED="false"

# [string] International phone number in E.164 format, including the +.
SIGNAL_PHONE=""

# [secret] CallMeBot API key for that phone number.
SIGNAL_APIKEY=""

# [url] CallMeBot Signal gateway.
SIGNAL_API_URL="https://signal.callmebot.com/signal/send.php"

# [string] Message templates. Supported placeholders:
#   {SOC}  {TRIGGER_SOC}  {RESET_SOC}  {HOST}
# The legacy spellings %SOC%, %TRIGGER%, %RESET%, %HOST% and %% are still
# accepted. UTF-8 text (umlauts, ß) is URL-encoded by curl at send time.
SIGNAL_MESSAGE_OVERFLOW="Achtung: Batteriespeicher hat {SOC}% erreicht! Überschuss verfügbar."
SIGNAL_MESSAGE_RESET="Batteriespeicher wieder unter {RESET_SOC}% ({SOC}%). Überschuss beendet."

# [string] Text used by `notify_signal.sh --test`. It is never written to the
# battery state files, so a test cannot look like a real overflow event.
SIGNAL_MESSAGE_TEST="Testnachricht von homematic-sma-battery-monitor auf {HOST}. Signal-Benachrichtigungen funktionieren."

# [bool: true|false] Also send a message on the first run when the signal is
# already active and no previous state file exists.
SIGNAL_NOTIFY_ON_START="false"

# [int, seconds] Timeout and retries for the notification request.
SIGNAL_TIMEOUT="15"
SIGNAL_RETRIES="2"

# [int, seconds] Suppress a duplicate of the same event (trigger/reset) inside
# this window. Default 60 minutes; 0 disables deduplication.
SIGNAL_COOLDOWN="3600"


# -----------------------------------------------------------------------------
#  Web dashboard (status.json written by check_soc.sh)
# -----------------------------------------------------------------------------

# [bool: true|false] Publish a status snapshot for the bundled dashboard.
WEB_ENABLED="true"

# [path] File served by lighttpd on the CCU. The deploy script installs the
# dashboard itself into /usr/local/etc/config/addons/www/sma_battery/.
WEB_STATUS_FILE="/usr/local/etc/config/addons/www/sma_battery/status.json"

# [int] Number of samples kept for the history sparkline (one sample per run).
WEB_HISTORY_POINTS="288"


# -----------------------------------------------------------------------------
#  Logging
# -----------------------------------------------------------------------------

# [path] Local log file. Set to "" to log to syslog/stderr only.
LOG_FILE="/usr/local/addons/sma_battery/state/check_soc.log"

# [int, bytes] Rotate the log file above this size (one .1 generation is kept).
LOG_MAX_BYTES="262144"


# -----------------------------------------------------------------------------
#  Deployment (used by deploy.sh on your workstation, ignored on the CCU)
# -----------------------------------------------------------------------------

# [string] SSH host of the CCU3. Can be overridden with deploy.sh -H.
DEPLOY_HOST="192.168.178.10"

# [string] SSH user (CCU3/RaspberryMatic default: root).
DEPLOY_USER="root"

# [int] SSH port.
DEPLOY_PORT="22"

# [path] Remote add-on directory (deploy.sh --dir overrides this).
DEPLOY_ADDON_DIR="/usr/local/addons/sma_battery"

# [path] Remote lighttpd directory for the dashboard
# (deploy.sh --web-dir overrides this).
DEPLOY_WEB_DIR="/usr/local/etc/config/addons/www/sma_battery"
